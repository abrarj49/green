# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/greensolution?retryWrites=true&w=majority

# Admin credentials
ADMIN_EMAIL=admin@greensolutionksa.com
ADMIN_PASSWORD_HASH=$2b$10$...  # bcrypt hash of admin password

# JWT secret for admin sessions
JWT_SECRET=your-secret-key-here

# Resend API key for email notifications
RESEND_API_KEY=re_xxxxxxxxxxxx

# Admin notification email
ADMIN_NOTIFICATION_EMAIL=chhameed@greensolutionksa.com

# Google Analytics measurement ID (optional)
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Site URL
NEXT_PUBLIC_SITE_URL=https://green-solution-site-website.vercel.app
